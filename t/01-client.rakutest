use v6.d;

use Test;
use WWW::HorizonsEphemerisSystem;
use WWW::HorizonsEphemerisSystem::Client;

class MockHTTPClient {
    has Str $.last-url is rw;
    has Hash $.reply is rw;
    has @.posts;

    method get(Str:D $url --> Hash:D) {
        $!last-url = $url;
        $!reply
    }

    method post(Str:D $url, :$content, :%headers --> Hash:D) {
        @!posts.push: {
            url => $url,
            content => $content.decode('utf8'),
            headers => %headers,
        };
        $!reply
    }
}

my $mock = MockHTTPClient.new(
    reply => {
        success => True,
        status  => 200,
        reason  => 'OK',
        headers => {},
        content => q:to/JSON/.encode('utf8')
        {
          "signature": {"version": "1.3", "source": "NASA/JPL Horizons API"},
          "result": "ok"
        }
        JSON
    }
);

my $client = WWW::HorizonsEphemerisSystem::Client.new(http-client => $mock);

is $client.percent-encode("'DES=141P;CAP;NOFRAG'"),
   '%27DES%3D141P%3BCAP%3BNOFRAG%27',
   'reserved characters are percent-encoded';

my $url = $client.build-url(
    format      => 'json',
    COMMAND     => "'499'",
    START_TIME  => "'2006-01-01'",
    STOP_TIME   => "'2006-01-20'",
    STEP_SIZE   => "'1 d'",
);

ok $url.starts-with('https://ssd.jpl.nasa.gov/api/horizons.api?'), 'build-url uses Horizons endpoint';
ok $url.contains('COMMAND=%27499%27'), 'COMMAND is encoded';
ok $url.contains('STEP_SIZE=%271%20d%27'), 'STEP_SIZE with space is encoded';

my $response = $client.observer-ephemeris(
    COMMAND    => "'499'",
    OBJ_DATA   => 'YES',
    MAKE_EPHEM => 'YES',
);

ok $response.success, 'response is successful';
is $response.status, 200, 'status is available';
ok $response.is-json, 'response format detected as json';
is $response.api-version, '1.3', 'signature version is extracted';
is $response.result, 'ok', 'JSON result payload extracted';
ok $mock.last-url.contains('EPHEM_TYPE=OBSERVER'), 'observer-ephemeris sets EPHEM_TYPE';

my $file-response = $client.vectors-ephemeris(
    COMMAND => "'499'",
    TLIST => "'2451544.5','2451545.5'",
    :transport<file>,
);
is $file-response.request-method, 'POST', 'file transport is a POST request';
is $file-response.request-url, 'https://ssd.jpl.nasa.gov/api/horizons_file.api', 'file transport uses file API endpoint';
my %post = $mock.posts[*-1];
ok %post<headers><content-type>.starts-with('multipart/form-data; boundary='), 'file request is multipart';
ok %post<content>.contains('!$$SOF'), 'file input has Horizons batch marker';
ok %post<content>.contains("TABLE_TYPE=VECTORS"), 'file input translates EPHEM_TYPE to TABLE_TYPE';
ok !%post<content>.contains('EPHEM_TYPE='), 'file input omits GET-only EPHEM_TYPE';
ok %post<content>.contains("TLIST='2451544.5','2451545.5'"), 'file input retains long-list value without URL encoding';

my $short-limit-client = WWW::HorizonsEphemerisSystem::Client.new(
    http-client => $mock,
    url-length-limit => 1,
);
$short-limit-client.query(COMMAND => "'499'");
is $mock.posts.elems, 2, 'auto transport selects file API when URL exceeds configured limit';

$mock.reply = {
    success => True,
    status  => 200,
    reason  => 'OK',
    headers => {},
    content => q:to/JSONERR/.encode('utf8')
    {
      "signature": {"version": "1.3", "source": "NASA/JPL Horizons API"},
      "error": "Object not found"
    }
    JSONERR
};

throws-like {
    $client.query(COMMAND => "'BAD'", format => 'json');
}, X::WWW::HorizonsEphemerisSystem::API, 'throws for API-level JSON error';

$mock.reply = {
    success => False,
    status  => 503,
    reason  => 'Service Unavailable',
    headers => {},
    content => ''.encode('utf8')
};

throws-like {
    $client.query(COMMAND => "'499'", format => 'json');
}, X::WWW::HorizonsEphemerisSystem::HTTP, 'throws for HTTP error response';

my $table = $client.extract-table(q:to/TABLE/);
prefix
$$SOE
line1
line2
$$EOE
suffix
TABLE
is $table, "line1\nline2", 'extract-table returns lines between $$SOE and $$EOE';

done-testing;
