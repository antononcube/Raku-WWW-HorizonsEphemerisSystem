use v6.d;

use Test;
use WWW::HorizonsEphemerisSystem;
use WWW::HorizonsEphemerisSystem::Client;

class MockHorizonsClient {
    has @.calls;

    method !response(Str:D $payload) {
        WWW::HorizonsEphemerisSystem::Response.new(
            success => True,
            status  => 200,
            reason  => 'OK',
            request-url => 'mock://horizons',
            headers => {},
            body => '',
            format => 'json',
            json => {
                signature => { version => '1.3', source => 'NASA/JPL Horizons API' },
                result => $payload,
            },
        )
    }

    method vectors-ephemeris(*%params) {
        @!calls.push: { method => 'vectors', params => %params };
        self!response(q:to/VECT/);
Target body name: Mars (499)
Center body name: Solar System Barycenter (0)
Reference frame: ICRF
Output units: KM-S
$$SOE
JDTDB,X,Y,Z
2451544.5,1.0,2.0,3.0
$$EOE
VECT
    }

    method observer-ephemeris(*%params) {
        @!calls.push: { method => 'observer', params => %params };
        self!response(q:to/OBS/);
HEADER
$$SOE
Date_________JDUT, , ,Azi_(a-app),Elev_(a-app),
2451544.5,N, ,120.5,35.2,
$$EOE
OBS
    }

    method elements-ephemeris(*%params) {
        @!calls.push: { method => 'elements', params => %params };
        self!response(q:to/ELEM/);
HEADER
$$SOE
JDTDB,EC,IN
2451544.5,0.004,1.2
2451545.5,0.005,1.3
$$EOE
ELEM
    }

    method spk-file(*%params) {
        @!calls.push: { method => 'spk', params => %params };
        WWW::HorizonsEphemerisSystem::Response.new(
            success => True,
            status => 200,
            reason => 'OK',
            request-url => 'mock://horizons',
            headers => {},
            body => '',
            format => 'json',
            json => {
                signature => { version => '1.3' },
                spk => 'BASE64-SPK',
                spk_file_id => 'mock.bsp',
            },
        )
    }

    method approach-table(*%params) {
        @!calls.push: { method => 'approach', params => %params };
        self!response(q:to/APPROACH/);
Target body name: Test object (999)
Center body name: Earth (399)
APPROACH
    }
}

my $mock = MockHorizonsClient.new;

# Command-style metadata calls from spec.
is-deeply horizons-ephemeris-data('state', 'query-parameters'),
          [<target center dates frame corrections>],
          'state query-parameters command works';

ok horizons-ephemeris-data('observer', 'properties').grep(* eq 'azimuth').so,
   'observer properties command works';

# 1) State default command.
my @state-default = horizons-ephemeris-data('state', '499', 'position', :client($mock));
is @state-default.elems, 1, 'state default returns one parsed row';
is @state-default[0]<X>, 1, 'state result has parsed X column';
ok @state-default[0]<Date>:exists, 'state mapping applies Date key';
isa-ok @state-default[0].context, EphemerisContext, 'parsed state row carries context directly';
is @state-default[0].context.time-scale, 'TDB', 'state context records explicit time scale';
is @state-default[0].context.unit-for('X'), 'km', 'state context records field units';
is @state-default[0].context.center, 'Solar System Barycenter (0)', 'state context prefers reported center';
is @state-default[0].context.reference-frame, 'ICRF', 'state context records reported frame';
ok @state-default[0].assert-compatible(@state-default[0]), 'records with equal contexts are compatible';

my %call1 = $mock.calls[*-1];
is %call1<method>, 'vectors', 'state uses vectors ephemeris call';
is %call1<params><COMMAND>, "'499'", 'state command target is mapped';
is %call1<params><VEC_TABLE>, "'2'", 'position maps to VEC_TABLE group 2';

# 2) State specific date command.
my @state-date = horizons-ephemeris-data(
    'state',
    ['499', { dates => 'now + 12 h' }],
    'position',
    :client($mock)
);

is @state-date.elems, 1, 'state with specific date returns parsed data';
ok @state-date[0]<Date>:exists, 'state mapping applies Date key with specific date';
my %call2 = $mock.calls[*-1];
ok (%call2<params><TLIST> // '').contains('now + 12 h'), 'single date maps to TLIST';

# 3) Observer Tycho from Moscow for next 12 hours.
my @observer = horizons-ephemeris-data(
    'observer',
    {
        target => 'Tycho',
        center => (55.7505, 37.6175),
        dates => ['now', 'now + 12 h', '10 m'],
    },
    <azimuth elevation>,
    :client($mock),
);

is @observer.elems, 1, 'observer example returns parsed row';
is @observer[0]<Azimuth>, 120.5, 'observer azimuth remains aligned after blank marker columns';
is @observer[0]<Elevation>, 35.2, 'observer elevation remains aligned after blank marker columns';
ok !@observer[0]<Azimuth>.isa(Failure), 'observer marker codes are not coerced as azimuth';

my %call3 = $mock.calls[*-1];
is %call3<method>, 'observer', 'observer etype uses observer-ephemeris';
is %call3<params><CENTER>, "'coord@399'", 'geo tuple center maps to coord center';
is %call3<params><SITE_COORD>, "'37.6175,55.7505,0'", 'geo tuple maps to lon,lat,h';
is %call3<params><STEP_SIZE>, "'10 m'", 'date interval step is mapped';
is %call3<params><QUANTITIES>, "'4'", 'azimuth/elevation map to quantities=4';

# 4) Orbital elements with explicit datetime list.
my %assoc = horizons-ephemeris-data(
    'orbital-elements',
    ['617', {
        center => '699',
        dates => [
            'Mon 10 Jan 2000 00:00:00',
            'Tue 11 Jan 2000 00:00:00',
        ],
    }],
    'all',
    :modifier<association>,
    :client($mock),
);

is %assoc.elems, 2, 'orbital-elements association has two keyed rows';
ok %assoc{'2451544.5'}<Date>:exists, 'orbital mapping applies Date key';
ok %assoc{'2451544.5'}<Eccentricity>:exists, 'orbital mapping applies Eccentricity key';
ok %assoc{'2451544.5'}<Inclination>:exists, 'orbital mapping applies Inclination key';
my %call4 = $mock.calls[*-1];
is %call4<method>, 'elements', 'orbital-elements uses elements-ephemeris';
ok %call4<params><TLIST>.contains('Mon 10 Jan 2000 00:00:00'), 'datetime list maps to TLIST';

my $dataset = horizons-ephemeris-data(
    'state', '499', 'position', :modifier<dataset>, :client($mock),
);
isa-ok $dataset, EphemerisDataset, 'dataset modifier returns a dataset object';
is $dataset.elems, 1, 'dataset contains parsed records';
is $dataset[0].context, $dataset.context, 'dataset records share dataset context';
ok $dataset.columns.grep(* eq 'X').so, 'dataset retains source column schema';

my @other-corrections = horizons-ephemeris-data(
    'state', { target => '499', corrections => 'light-time' }, 'position', :client($mock),
);
throws-like {
    @state-default[0].assert-compatible(@other-corrections[0]);
}, X::AdHoc, 'compatibility check rejects records with different corrections';

my $spk = horizons-ephemeris-data(
    'spk', { target => '1;', dates => ['2020-01-01', '2030-12-31'] }, :client($mock),
);
isa-ok $spk, SPKResult, 'SPK product has a high-level result object';
is $spk.content, 'BASE64-SPK', 'SPK result exposes encoded content';
is $spk.file-id, 'mock.bsp', 'SPK result exposes suggested file name';
my %spk-call = $mock.calls[*-1];
is %spk-call<method>, 'spk', 'SPK high-level product uses spk-file client method';
is %spk-call<params><START_TIME>, "'2020-01-01'", 'SPK start date is normalized';
is %spk-call<params><STOP_TIME>, "'2030-12-31'", 'SPK stop date is normalized';

my $approach = horizons-ephemeris-data(
    'approach', { target => '999', close-approach-table-type => 'extended' }, :client($mock),
);
isa-ok $approach, ApproachResult, 'APPROACH product has a high-level result object';
ok $approach.text.contains('Target body name'), 'APPROACH result preserves Horizons table text';
my %approach-call = $mock.calls[*-1];
is %approach-call<method>, 'approach', 'APPROACH high-level product uses approach-table client method';
is %approach-call<params><CA_TABLE_TYPE>, 'EXTENDED', 'APPROACH options are normalized';

# Raw mode exposes request envelope.
my %raw = horizons-ephemeris-data('state', '499', 'position', :raw, :client($mock));
ok %raw<api-params>:exists, 'raw mode includes api params';
ok %raw<response>:exists, 'raw mode includes response';

done-testing;
